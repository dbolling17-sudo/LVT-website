# Copy to .env.local for local work; set the same values in Vercel → Project → Settings → Environment Variables.

# The live site's address, used for share links, the sitemap and search results.
# Optional: defaults to the Vercel production domain.
SITE_URL=https://www.example.com

# Optional override for the Heartland ordering link (defaults to the confirmed URL in src/config/site.ts).
# NEXT_PUBLIC_ORDER_URL=

# Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty to send nothing.
NEXT_PUBLIC_GA4_ID=

# Sanity project. Defaults to Devon's project (vp3mgov9); set to an empty value to run without Sanity.
# NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for the Sanity publish webhook that refreshes pages (POST /api/revalidate).
SANITY_REVALIDATE_SECRET=

# Editor token for scripts/seed-weekly-specials.mjs. Never commit it or expose it to the browser.
SANITY_API_TOKEN=
